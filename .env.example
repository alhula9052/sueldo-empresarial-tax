# No contiene secretos. Django lee el entorno del proceso; no carga este archivo automáticamente.
DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost
# Obligatoria cuando DEBUG=0. Genere una clave local aleatoria; nunca la versione.
DJANGO_SECRET_KEY=
# Opcional: ruta absoluta de SQLite. Por defecto db.sqlite3.
# DATABASE_PATH=/ruta/privada/nexo.sqlite3
# DEMO_PASSWORD=   # Opcional, solo para seed_demo; no usar en producción.
# CLIENT_ADMIN_PASSWORD=  # Opcional para create_client; alternativa: entrada oculta interactiva.
